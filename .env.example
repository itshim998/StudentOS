STUDENTOS_PORT=3101
STUDENTOS_API_BASE=http://localhost:3101
STUDENTOS_ENV=development
STUDENTOS_DEPLOYMENT=local
STUDENTOS_BACKGROUND_WORKERS_ENABLED=false
STUDENTOS_ADAPTIVE_RECOVERY_ENABLED=false
STUDENTOS_RECOVERY_PREVIEW_TTL_HOURS=24
# Use mock for local development, supabase for real persistence, or auto to use Supabase when all required keys exist.
STUDENTOS_MODE=mock
CORS_ORIGINS=http://localhost:3101,http://127.0.0.1:3101
STUDENTOS_DEMO_SEED_ENABLED=false
STUDENTOS_DEFAULT_PLAN=starter
STUDENTOS_QUOTA_ENFORCEMENT=false
STUDENTOS_RATE_LIMIT_ENABLED=false
STUDENTOS_RATE_LIMIT_WINDOW_MS=60000
STUDENTOS_RATE_LIMIT_MAX_REQUESTS=600
STUDENTOS_PRIVACY_VERSION=privacy-2026-05
STUDENTOS_TERMS_VERSION=terms-2026-05
STUDENTOS_CONSENT_SCHEMA_VERSION=consent-v1
STUDENTOS_ACCOUNT_DELETION_GRACE_DAYS=14
STUDENTOS_ROLE_INVITATIONS_ENABLED=false
STUDENTOS_INTERNAL_OPS_ENABLED=false
STUDENTOS_INTERNAL_OPS_TOKEN=
STUDENTOS_OPERATOR_SESSION_SECRET=
STUDENTOS_OPERATOR_SESSION_VERSION=v1
STUDENTOS_OPERATOR_SESSION_TTL_SECONDS=300
STUDENTOS_OPERATOR_ROSTER_JSON=[]
STUDENTOS_OPERATOR_MFA_REQUIRED=false
STUDENTOS_OPERATOR_MFA_REQUIRED_PERMISSIONS=deletion:execute,billing:waive,exports:cleanup
STUDENTOS_OPERATOR_MFA_METHODS=totp,phone
STUDENTOS_OPERATOR_MFA_CHALLENGE_TTL_SECONDS=300
STUDENTOS_OPERATOR_MFA_VERIFICATION_TTL_SECONDS=300
STUDENTOS_OPERATOR_MFA_MOCK_ENABLED=false
STUDENTOS_OPERATOR_MFA_MOCK_CODE=
STUDENTOS_FINAL_ACCOUNT_DELETION_ENABLED=false
STUDENTOS_AUTH_ADMIN_DELETE_ENABLED=false
STUDENTOS_DELETION_DUAL_CONTROL_REQUIRED=true
STUDENTOS_DELETION_EVIDENCE_ENABLED=true
STUDENTOS_DELETION_REQUIRED_APPROVALS=2
STUDENTOS_DELETION_DIFF_MAX_ROW_CHANGE=25
STUDENTOS_DELETION_ALLOW_BILLING_MARK_ONLY=false
STUDENTOS_BILLING_CANCELLATION_PROVIDER_CALLS_ENABLED=false
STUDENTOS_BILLING_CANCELLATION_MANUAL_WAIVER_ENABLED=false
STUDENTOS_BILLING_CANCELLATION_POLICY=immediate
STUDENTOS_MONITORING_ALERTS_ENABLED=true
STUDENTOS_MONITORING_ALERT_PROVIDER=log
# Password recovery only. Sign-up verification derives /auth/callback from the current frontend origin.
STUDENTOS_AUTH_REDIRECT_URL=http://localhost:3101/auth/complete
STUDENTOS_PUBLIC_FRONTEND_URL=http://localhost:3101

# Billing provider boundary. Payments stay inactive unless launch flags are explicitly enabled.
STUDENTOS_BILLING_PROVIDER=none
STUDENTOS_BILLING_LIVE_CHARGES_ENABLED=false
STUDENTOS_BILLING_CHECKOUT_REDIRECT_ENABLED=false
STUDENTOS_BILLING_MOCK_WEBHOOK_SECRET=
# Development-only lifecycle gates. Production ignores these simulation flags.
STUDENTOS_PAYMENT_PLACEHOLDER_ENABLED=true
# Tier access gate. Set to false only for demo or presentation. Default true = normal payment verification.
STUDENTOS_TIER_OPERATIONAL=true
STUDENTOS_WORKSPACE_PREPARATION_SIMULATION_ENABLED=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

# Project 1: StudentOS Auth only. The anon key is public-login capable; service keys stay backend-only.
STUDENTOS_SUPABASE_URL_1=
STUDENTOS_SUPABASE_SERVICE_ROLE_KEY_1=
STUDENTOS_SUPABASE_ANON_KEY_1=

# Projects 2, 3, 4: backend-only StudentOS data shards.
STUDENTOS_SUPABASE_URL_2=
STUDENTOS_SUPABASE_SERVICE_ROLE_KEY_2=
STUDENTOS_SUPABASE_URL_3=
STUDENTOS_SUPABASE_SERVICE_ROLE_KEY_3=
STUDENTOS_SUPABASE_URL_4=
STUDENTOS_SUPABASE_SERVICE_ROLE_KEY_4=
STUDENTOS_SUPABASE_JWT_SECRET=
STUDENTOS_STORAGE_BUCKET=studentos-source-materials
STUDENTOS_EXPORT_STORAGE_BUCKET=studentos-data-exports
STUDENTOS_EXPORT_DOWNLOAD_EXPIRY_SECONDS=900
STUDENTOS_EXPORT_RETENTION_HOURS=48

# Local development can use mock. Production should use disabled, or oauth only after the backend-only OAuth secrets below are configured.
STUDENTOS_GOOGLE_CLASSROOM_MODE=mock
STUDENTOS_GOOGLE_CLASSROOM_OAUTH_STATE_SECRET=
STUDENTOS_GOOGLE_CLASSROOM_TOKEN_ENCRYPTION_SECRET=
STUDENTOS_GOOGLE_CLASSROOM_TOKEN_KEY_ID=studentos-google-classroom-token-v1
STUDENTOS_GOOGLE_CLASSROOM_DRIVE_METADATA_ENABLED=false
STUDENTOS_GOOGLE_CLASSROOM_MAX_IMPORTED_ASSIGNMENTS=200
STUDENTOS_GOOGLE_CLASSROOM_MAX_IMPORTED_MATERIALS=400
GOOGLE_WORKSPACE_CONNECTOR_MODE=mock
# Web OAuth client ID only. Do not include https:// or a trailing slash.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3101/api/classroom/oauth/callback

# Backend-only AI provider keys. Numbered keys are preferred; GROQ_API_KEY is the single-key fallback.
# Do not comma-separate keys. GROQ_API_KEYS is not supported. Never expose these to frontend HTML.
STUDENTOS_AI_MODE=auto
STUDENTOS_AI_REASONING_EFFORT=medium
STUDENTOS_AI_MAX_COMPLETION_TOKENS=3000
STUDENTOS_AI_PROVIDER_CYCLE_ENABLED=false
STUDENTOS_AI_PROVIDER_CYCLE_SHADOW=false
STUDENTOS_AI_PROVIDER_CYCLE_ROLLOUT_PERCENT=0
STUDENTOS_AI_ROUTER_V2_ENABLED=false
STUDENTOS_AI_ROUTER_V2_ROLLOUT_PERCENT=0
STUDENTOS_AI_GROQ_ENABLED=true
STUDENTOS_AI_GEMINI_ENABLED=true
STUDENTOS_AI_NVIDIA_ENABLED=false
STUDENTOS_AI_POLLINATIONS_ENABLED=true
STUDENTOS_AI_LOGICAL_OPERATION_TIMEOUT_MS=120000
STUDENTOS_AI_OPERATION_LEASE_MS=180000
STUDENTOS_AI_CONCURRENT_WAIT_MS=5000
STUDENTOS_AI_WEEKLY_ALLOWANCE_TRIAL=15
STUDENTOS_AI_WEEKLY_ALLOWANCE_STARTER=35
STUDENTOS_AI_WEEKLY_ALLOWANCE_ESSENTIAL=90
STUDENTOS_AI_WEEKLY_ALLOWANCE_PLUS=220
STUDENTOS_AI_WEEKLY_ALLOWANCE_PRO=500
GROQ_API_KEY=
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_OPENAI_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
GROQ_TIMEOUT_MS=45000
GROQ_KEY_COOLDOWN_MS=60000
GROQ_429_COOLDOWN_MS=180000
GEMINI_API_KEY=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_MS=45000
GEMINI_KEY_COOLDOWN_MS=60000
GEMINI_429_COOLDOWN_MS=180000
GEMINI_INVALID_KEY_DISABLE=true
NVIDIA_API_KEY=
NVIDIA_API_KEY_1=
NVIDIA_API_KEY_2=
NVIDIA_API_KEY_3=
NVIDIA_OPENAI_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_TEXT_MODEL=moonshotai/kimi-k2.6
# Strict JSON skips NVIDIA while this is empty. Configure only a registry-verified structured-output model.
NVIDIA_STRUCTURED_MODEL=
NVIDIA_TIMEOUT_MS=45000
NVIDIA_KEY_COOLDOWN_MS=60000
NVIDIA_429_COOLDOWN_MS=180000
POLLINATIONS_API_KEY=
POLLINATIONS_ALLOW_FREE=false
POLLINATIONS_BASE_URL=https://gen.pollinations.ai
POLLINATIONS_OPENAI_ENDPOINT=https://gen.pollinations.ai/v1/chat/completions
POLLINATIONS_FALLBACK_OPENAI_ENDPOINT=https://text.pollinations.ai/openai
POLLINATIONS_TEXT_MODEL=gpt-oss
POLLINATIONS_IMAGE_MODEL=zimage
POLLINATIONS_TIMEOUT_MS=60000
POLLINATIONS_FALLBACK_MAX_MS=3600000
POLLINATIONS_UPSTREAM_PROBE_INTERVAL_MS=300000

# Embeddings are mock/deterministic by default. Real mode is backend-only and explicit.
STUDENTOS_EMBEDDING_MODE=mock
STUDENTOS_EMBEDDING_PROVIDER=mock
STUDENTOS_EMBEDDING_DIMENSIONS=384
STUDENTOS_EMBEDDING_ENDPOINT=
STUDENTOS_EMBEDDING_API_KEY=
STUDENTOS_EMBEDDING_MODEL=
